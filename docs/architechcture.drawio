<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-04T00:00:00.000Z" agent="Tasi Harness" version="1.7.0" type="device">
  <diagram id="tasi-harness-code-architecture-v1-7-0" name="Tasi Harness 1.7.0 Code Architecture"><mxGraphModel dx="2400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Tasi Harness Architecture" style="text;html=1;strokeColor=none;fillColor=none;fontSize=52;fontStyle=1;fontColor=#071327;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="0" y="35" width="2400" height="58" as="geometry"/></mxCell><mxCell id="subtitle" value="Code-faithful v1.7.0 runtime: host AgentLoop is primary; DSH sidecar is required only for DSH plugin tools, skills, commands, and client UI" style="text;html=1;strokeColor=none;fillColor=none;fontSize=23;fontColor=#334155;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="140" y="98" width="2120" height="36" as="geometry"/></mxCell><mxCell id="legend" value="Solid vertical = normal call path. Solid horizontal = explicit bridge. Connection dots mark source and target boundaries." style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=#64748b;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="520" y="138" width="1360" height="30" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#0f172a&quot;&gt;Entry Surfaces&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Renderer React App: chat, files, artifacts, @plugin menu&lt;br&gt;CLI shares AgentLoop through src/main/cli.ts&lt;br&gt;External IM can re-enter via sidecar main.chat.run callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="80" y="170" width="660" height="120" as="geometry"/></mxCell><mxCell id="ipc" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#083344&quot;&gt;Preload + Main IPC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;window.tasiHarness in src/preload/preload.ts&lt;br&gt;main.ts handles agent:chat, tools:*, sessions:*, app:*&lt;br&gt;Also exposes dsh-sidecar:* and plugins:market:* endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="80" y="350" width="660" height="120" as="geometry"/></mxCell><mxCell id="appctx" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#083344&quot;&gt;AppContext Composition Root&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Creates stores, SkillManager, browser router, sandbox, scheduler&lt;br&gt;Registers built-in tools into ToolRegistry&lt;br&gt;Constructs DSH manager, marketplace manager, runtime bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="80" y="530" width="660" height="120" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#3b0764&quot;&gt;AgentLoop&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Builds prompt, streams deltas, executes model tool-call loop&lt;br&gt;resolvePluginMentions only adds DSH context/tool names&lt;br&gt;Ordinary chat does not depend on sidecar availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="80" y="710" width="660" height="120" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#064e3b&quot;&gt;ToolRegistry + Built-in Tools&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Executes built-ins from createBuiltinTools()&lt;br&gt;Executes DSH proxy tools only after RuntimeBridge registers them&lt;br&gt;Tool calls carry sessionId, workspaceDir and approval context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="80" y="890" width="660" height="120" as="geometry"/></mxCell><mxCell id="services" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#064e3b&quot;&gt;Host Domain Services&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Config/session/memory/task/MCP stores&lt;br&gt;SkillManager, MarketplaceManager, PersonalKnowledgeBase, session docs&lt;br&gt;BrowserAutomationRouter, SandboxManager, EmailNotifier, TaskScheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="80" y="1070" width="660" height="120" as="geometry"/></mxCell><mxCell id="hostStore" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#0f172a&quot;&gt;Host Persistence + Outputs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;~/.tasi-harness/config.json, sessions, memories, tasks, MCP config&lt;br&gt;personal-knowledge, session-documents, sandboxes, logs&lt;br&gt;artifacts, previews, screenshots, PDF/DOCX export, notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="80" y="1250" width="660" height="120" as="geometry"/></mxCell><mxCell id="pluginEntry" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#7c2d12&quot;&gt;DSH Plugin Entry Points&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Plugins page browse/detail/install/enable/disable&lt;br&gt;@plugin mention can prefer plugin tools or commands&lt;br&gt;Client mount windows open through dsh-sidecar:client-mounts:*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="920" y="170" width="660" height="120" as="geometry"/></mxCell><mxCell id="dshIpc" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#7c2d12&quot;&gt;DSH IPC Surface In main.ts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;dsh-sidecar:status/start/stop/plugins/runtime/client-mounts/chat&lt;br&gt;plugins:market:browse/detail/install&lt;br&gt;maybeRunDshSidecarChatTurn runs before normal AgentLoop fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="920" y="350" width="660" height="120" as="geometry"/></mxCell><mxCell id="dshManagers" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#7c2d12&quot;&gt;DSH Managers In Main Process&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;DshPluginMarketplaceManager resolves SkillHub/GitHub/NPM installs&lt;br&gt;DshSidecarManager is the typed RPC facade&lt;br&gt;DshSidecarRuntimeBridge syncs tools/skills into the host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="920" y="530" width="660" height="120" as="geometry"/></mxCell><mxCell id="dshDecision" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#7c2d12&quot;&gt;DSH Runtime Decision Points&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Direct route: @plugin + commands.length &gt; 0 -&gt; sidecar chat.run&lt;br&gt;Normal route: runtimeBridge.sync() before AgentLoop&lt;br&gt;Callback route: sidecar may request main.chat.run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="920" y="710" width="660" height="120" as="geometry"/></mxCell><mxCell id="bridge" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#7c2d12&quot;&gt;RuntimeBridge Boundary&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;runtime.tools -&gt; ToolRegistry.register(proxy tool)&lt;br&gt;runtime.skills -&gt; SkillManager.setRuntimeSkills&lt;br&gt;Proxy execute -&gt; runtime.tool.call with workspace/session/LLM context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="920" y="890" width="660" height="120" as="geometry"/></mxCell><mxCell id="rpc" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#7c2d12&quot;&gt;Sidecar Manager + RpcClient&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Manager methods map to sidecar RPC methods&lt;br&gt;RpcClient spawns dshSidecarProcess.js with ELECTRON_RUN_AS_NODE=1&lt;br&gt;Line-delimited JSON RPC over stdio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="920" y="1070" width="660" height="120" as="geometry"/></mxCell><mxCell id="sidecar" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#7c2d12&quot;&gt;dshSidecarProcess.js + DshCordisHost&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Profile env plus pnpm install/upload/enable/disable/uninstall dispatch&lt;br&gt;Loads plugin entry plus bundle patch, then apply(ctx, config)&lt;br&gt;Cordis services include tools, commands, settings, skills, web, attachments, llm, sessions, agents, subagents, storage, sandboxPolicy, workspaceRegistry, webServer, clientRuntime, slots/locale/remote" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="920" y="1250" width="660" height="150" as="geometry"/></mxCell><mxCell id="meaning" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#0f172a&quot;&gt;Sidecar Role&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Not required for ordinary host chat or built-in tools&lt;br&gt;Required for DSH plugin tools, runtime skills, commands and client UI&lt;br&gt;If sync fails, main.ts catches it and AgentLoop runs with zero DSH tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="1690" y="710" width="620" height="120" as="geometry"/></mxCell><mxCell id="dshStore" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px&quot; color=&quot;#0f172a&quot;&gt;DSH Profile State + Client Runtime&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;~/.tasi-harness/dsh-sidecar/profiles/default package.json and lockfile&lt;br&gt;DshSidecarStore plugin records and bundle patch metadata&lt;br&gt;Sidecar HTTP server serves plugin web routes and client mounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;fontSize=16;arcSize=8" vertex="1" parent="1"><mxGeometry x="1690" y="1250" width="620" height="150" as="geometry"/></mxCell><mxCell id="edge-0" value="host request" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="entry" target="ipc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="constructed services" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="ipc" target="appctx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="agent:chat" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="appctx" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="tool loop" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="agent" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="uses services" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="tools" target="services"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="persist outputs" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="services" target="hostStore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="dsh-sidecar:*" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="pluginEntry" target="dshIpc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="manager calls" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="dshIpc" target="dshManagers"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="status + routing" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="dshManagers" target="dshDecision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-9" value="sync / proxy" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="dshDecision" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-10" value="runtime RPC" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="bridge" target="rpc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-11" value="spawn + dispatch" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="rpc" target="sidecar"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-12" value="profile + client UI" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="sidecar" target="dshStore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-13" value="constructs" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="appctx" target="dshManagers"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-14" value="register tools/skills and proxy tool calls" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="bridge" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-15" value="role" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=3;" edge="1" parent="1" source="dshDecision" target="meaning"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
